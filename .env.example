# Telegram Bot API token from @BotFather
BOT_TOKEN=123456:replace-me

# API key from Google AI Studio
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.5-flash
# Used on retries when the primary model is overloaded (leave empty to disable)
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

DATABASE_URL=sqlite+aiosqlite:///./data/news_bot.db

# INFO or DEBUG
LOG_LEVEL=INFO

# Optional: RSS poll interval in minutes (30-60 recommended)
FETCH_INTERVAL_MINUTES=30

# Optional: custom RSS feed sources as a JSON list (defaults to Suspilne, BBC Ukraine, Pravda)
# RSS_FEEDS='[{"name": "Суспільне", "url": "https://suspilne.media/rss/all.rss"}]'

# Optional: comma-separated Telegram user IDs allowed to view /stats
# ADMIN_IDS=123456789,987654321
